package "adf.core.agent.communication.standard.bundle" {

    abstract class StandardMessage {
        # senderID : EntityID
        # ttl : int
        # sendingPriority : StandardMessagePriority
        --
        + StandardMessage(boolean, StandardMessagePriority)
        + StandardMessage(boolean, int, int, BitStreamReader)
        --
        + getSenderID() : EntityID
        + getTTL() : int
        + getSendingPriority() : StandardMessagePriority
        # getBitSize(int) : int
    }

    enum StandardMessagePriority {
        LOW
        NORMAL
        HIGH
    }

    class StandardMessageBundle {
        + StandardMessageBundle()
        --
        + getMessageClassList() : List<Class<? extends CommunicationMessage>>
    }

    class MessageUtil <<static helper>> {
        + {static} reflectMessage(WorldInfo, StandardMessage) : StandardEntity
        + {static} reflectMessage(WorldInfo, MessageBuilding) : Building
        + {static} reflectMessage(WorldInfo, MessageRoad) : Road
        + {static} reflectMessage(WorldInfo, MessageCivilian) : Civilian
        + {static} reflectMessage(WorldInfo, MessageAmbulanceTeam) : AmbulanceTeam
        + {static} reflectMessage(WorldInfo, MessageFireBrigade) : FireBrigade
        + {static} reflectMessage(WorldInfo, MessagePoliceForce) : PoliceForce
    }
}

