@startuml 01_agent_info
' adf-core-java (core-docs) - adf.core.agent.info
' Source: core-docs/agent/info/{AgentInfo, ScenarioInfo}.md
' WorldInfo is in 02_world_info.puml

skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor #FDFDFD
skinparam ClassBorderColor #444444
hide empty members

package "adf.core.agent.info" {

class AgentInfo {
    - agent : Agent
    - world : StandardWorldModel
    - time : int
    - changed : ChangeSet
    - heard : Collection<Command>
    - thinkStartTime : long
    - actionHistory : Map<Integer, Action>
    --
    + AgentInfo(Agent, StandardWorldModel)
    --
    + getID() : EntityID
    + me() : StandardEntity
    + getX() : double
    + getY() : double
    + getPosition() : EntityID
    + getPositionArea() : Area
    --
    + setTime(int) : void
    + getTime() : int
    + setHeard(Collection<Command>) : void
    + getHeard() : Collection<Command>
    + setChanged(ChangeSet) : void
    + getChanged() : ChangeSet
    --
    + someoneOnBoard() : Human
    + isWaterDefined() : boolean
    + getWater() : int
    --
    + getExecutedAction(int) : Action
    + setExecutedAction(int, Action) : void
    + recordThinkStartTime() : void
    + getThinkTimeMillis() : long
}

class ScenarioInfo {
    - config : Config
    - mode : Mode
    --
    + ScenarioInfo(Config, Mode)
    + ScenarioInfo(Config)
    --
    + getMode() : Mode
    + getRawConfig() : Config
    + setConfig(Config) : void
    --
    + getFireExtinguishMaxSum() : int
    + getFireExtinguishMaxDistance() : int
    + getFireTankMaximum() : int
    + getFireTankRefillRate() : int
    + getFireTankRefillHydrantRate() : int
    --
    + getClearRepairRate() : int
    + getClearRepairDistance() : int
    + getClearRepairRad() : int
    --
    + getPerceptionLosMaxDistance() : int
    + getPerceptionLosPrecisionDamage() : int
    + getPerceptionLosPrecisionHp() : int
    --
    + getCommsChannelsCount() : int
    + getCommsChannelBandwidth(int) : int
    + getCommsChannelsMaxPlatoon() : int
    + getCommsChannelsMaxOffice() : int
    + getVoiceMessagesSize() : int
    --
    + getKernelHost() : String
    + getKernelTimesteps() : int
    + getKernelAgentsThinkTime() : int
    + getKernelStartupConnectTime() : int
    + getKernelAgentsIgnoreuntil() : int
    + getKernelCommunicationModel() : String
    + getKernelPerception() : String
    --
    + getScenarioAgentsAt() : int
    + getScenarioAgentsFb() : int
    + getScenarioAgentsPf() : int
    + getScenarioAgentsAc() : int
    + getScenarioAgentsFs() : int
    + getScenarioAgentsPo() : int
    --
    + isDebugMode() : boolean
    + isDevelopMode() : boolean
}

enum Mode {
    NON_PRECOMPUTE
    PRECOMPUTED
    PRECOMPUTATION_PHASE
}

}

ScenarioInfo *-- Mode

note bottom of AgentInfo
  WorldInfo (the third info object)
  is defined in 02_world_info.puml
end note

@enduml
