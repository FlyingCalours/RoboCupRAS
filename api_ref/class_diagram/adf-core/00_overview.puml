@startuml 00_overview
' adf-core-java (core-docs) - structural overview, members omitted
' Every class documented in core-docs, grouped by package.
' Full attributes/methods are in files 01-11.

skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor #FDFDFD
skinparam ClassBorderColor #444444
hide members

package "adf.core.agent.info" {
    class AgentInfo
    class WorldInfo
    class ScenarioInfo
    enum Mode
}

package "adf.core.agent.action" {
    abstract class Action
    class ActionMove
    class ActionRest
    class "ActionRescue (ambulance)" as ActionRescueAmbulance
    class ActionLoad
    class ActionUnload
    class ActionExtinguish
    class ActionRefill
    class "ActionRescue (fire)" as ActionRescueFire
    class ActionClear
}

package "adf.core.component.communication" {
    abstract class CommunicationMessage
    abstract class MessageBundle
    abstract class MessageCoordinator
    class ChannelSubscriber
    abstract class CommunicationModule
}

package "adf.core.agent.communication" {
    class MessageManager
    abstract class StandardMessage
    enum StandardMessagePriority
    class StandardMessageBundle
    class MessageUtil
    class MessageCivilian
    class MessageBuilding
    class MessageRoad
    class MessageAmbulanceTeam
    class MessageFireBrigade
    class MessagePoliceForce
    class CommandAmbulance
    class CommandFire
    class CommandPolice
    class CommandScout
    class MessageReport
}

package "adf.core.agent (managers & data)" {
    class ModuleManager
    class ModuleConfig
    class DevelopData
    class PrecomputeData
}

package "adf.core.component.tactics" {
    abstract class Tactics
    abstract class TacticsAmbulanceTeam
    abstract class TacticsFireBrigade
    abstract class TacticsPoliceForce
    abstract class TacticsCenter
    abstract class TacticsAmbulanceCentre
    abstract class TacticsFireStation
    abstract class TacticsPoliceOffice
}

package "adf.core.component.module" {
    abstract class AbstractModule
    abstract class PathPlanning
    abstract class Clustering
    abstract class StaticClustering
    abstract class DynamicClustering
    abstract class "TargetDetector<E>" as TargetDetector
    abstract class Search
    abstract class BuildingDetector
    abstract class HumanDetector
    abstract class RoadDetector
    abstract class "TargetSelector<E>" as TargetSelector
    abstract class BuildingSelector
    abstract class HumanSelector
    abstract class RoadSelector
    abstract class TargetAllocator
    abstract class AmbulanceTargetAllocator
    abstract class FireTargetAllocator
    abstract class PoliceTargetAllocator
}

package "adf.core.component (extaction & centralized)" {
    abstract class ExtAction
    abstract class CommandPicker
    abstract class "CommandExecutor<C>" as CommandExecutor
}

ScenarioInfo *-- Mode

Action <|-- ActionMove
Action <|-- ActionRest
Action <|-- ActionRescueAmbulance
Action <|-- ActionLoad
Action <|-- ActionUnload
Action <|-- ActionExtinguish
Action <|-- ActionRefill
Action <|-- ActionRescueFire
Action <|-- ActionClear

CommunicationMessage <|-- StandardMessage
MessageBundle <|-- StandardMessageBundle
StandardMessage <|-- MessageCivilian
StandardMessage <|-- MessageBuilding
StandardMessage <|-- MessageRoad
StandardMessage <|-- MessageAmbulanceTeam
StandardMessage <|-- MessageFireBrigade
StandardMessage <|-- MessagePoliceForce
StandardMessage <|-- CommandAmbulance
StandardMessage <|-- CommandFire
StandardMessage <|-- CommandPolice
StandardMessage <|-- CommandScout
StandardMessage <|-- MessageReport
StandardMessage ..> StandardMessagePriority
MessageUtil ..> StandardMessage

MessageManager o-- MessageCoordinator
MessageManager o-- ChannelSubscriber
CommunicationModule ..> MessageManager

Tactics <|-- TacticsAmbulanceTeam
Tactics <|-- TacticsFireBrigade
Tactics <|-- TacticsPoliceForce
TacticsCenter <|-- TacticsAmbulanceCentre
TacticsCenter <|-- TacticsFireStation
TacticsCenter <|-- TacticsPoliceOffice

AbstractModule <|-- PathPlanning
AbstractModule <|-- Clustering
Clustering <|-- StaticClustering
Clustering <|-- DynamicClustering
AbstractModule <|-- TargetDetector
TargetDetector <|-- Search
TargetDetector <|-- BuildingDetector
TargetDetector <|-- HumanDetector
TargetDetector <|-- RoadDetector
TargetDetector <|-- TargetSelector
BuildingDetector <|-- BuildingSelector
HumanDetector <|-- HumanSelector
RoadDetector <|-- RoadSelector
AbstractModule <|-- TargetAllocator
TargetAllocator <|-- AmbulanceTargetAllocator
TargetAllocator <|-- FireTargetAllocator
TargetAllocator <|-- PoliceTargetAllocator

ModuleManager ..> AbstractModule : creates
ModuleManager ..> ExtAction : creates
ModuleManager ..> CommandExecutor : creates
ModuleManager ..> CommandPicker : creates
ModuleManager ..> ChannelSubscriber : creates
ModuleManager ..> MessageCoordinator : creates
ModuleManager --> ModuleConfig

Tactics ..> Action : returns
Tactics o-- AbstractModule
Tactics o-- ExtAction
Tactics o-- CommandExecutor
TacticsCenter o-- AbstractModule
TacticsCenter o-- CommandPicker

ExtAction ..> Action
CommandExecutor ..> Action
CommandPicker ..> TargetAllocator

@enduml
